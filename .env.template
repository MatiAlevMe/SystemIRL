# ============================================================
# SystemIRL — variables de entorno
# Copia este archivo a `.env` y completa tus valores reales.
# NUNCA subas `.env` al repo (ya está en .gitignore).
# ============================================================

# ---- Portal (dashboard: https://hack.useportal.co) ----------
# Publishable key (pk_...): vive en el navegador, es segura exponerla.
# Se crea en el dashboard de Portal (API Keys -> publishable).
VITE_PORTAL_PUBLISHABLE_KEY=pk_tu_publishable_key_aqui

# Secret key (sk_...): SOLO server-side. La usa el CLI para desplegar
# portal.config.ts y los serverless functions para mintear tokens.
# Se crea en el dashboard de Portal (API Keys -> secret).
# Se configura en Vercel como env var (NO como VITE_).
PORTAL_SECRET=sk_tu_secret_key_aqui

# ---- Proveedor de IA para quests (api/quests.ts) -------------
# auto (default): prueba en orden los proveedores que tengan key
# configurada: gemini -> kilo -> zen.
# Puedes forzar uno: gemini | kilo | zen.
QUEST_PROVIDER=auto

# ---- Google Gemini (https://aistudio.google.com/apikey) -------
# Key de la API de Gemini. SOLO server-side (la lee api/quests.ts).
# Se configura en Vercel como env var (NO como VITE_).
# Modelos free actuales: gemini-3.6-flash (default), gemini-2.5-flash.
# Nota: gemini-2.0-flash ya NO tiene free tier (HTTP 429 limit 0).
GEMINI_API_KEY=tu_gemini_api_key_aqui
# GEMINI_MODEL=gemini-3.6-flash

# ---- Kilo Gateway (https://kilo.ai) ---------------------------
# OpenAI-compatible. Free tier ~200 req/hr, sin tarjeta de crédito.
# Modelos free: inclusionai/ling-3.0-flash:free (default),
# nvidia/nemotron-3-super-120b-a12b:free.
# Se configura en Vercel como env var (NO como VITE_).
KILO_API_KEY=tu_kilo_api_key_aqui
# KILO_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---- OpenCode Zen (https://opencode.ai/zen) -------------------
# OpenAI-compatible. Modelos free: big-pickle (default),
# deepseek-v4-flash-free, mimo-v2.5-free, nemotron-3-ultra-free.
# Key en opencode.ai -> Settings -> Zen API keys.
# Se configura en Vercel como env var (NO como VITE_).
ZEN_API_KEY=tu_zen_api_key_aqui
# ZEN_MODEL=big-pickle

# ============================================================
# Constantes de balance del juego (src/lib/balance.ts)
# Estas NO son env vars — están hardcodeadas en el código fuente.
# Se documentan aquí como referencia para ajustes de diseño.
# Para cambiarlas, edita directamente src/lib/balance.ts.
# ============================================================
#
# EX Level:
#   MAX_EX_LEVEL = 99          — Cap máximo de nivel EX del jugador
#   exXpForLevel(n) = 40+n*2  — XP requerida para subir al nivel n de EX
#   exEffectMultiplier(n) = 1 + 0.03*(n-1)  — +3% de efectividad por nivel EX
#   Hitos pasivos: Lv10 +10% MP regen, Lv25 +5% crit, Lv75 +5% HP máx
#
# Raid Semanal (ciclo lunes-domingo, semana ISO):
#   RAID_BOSS_HP = 500         — HP total del jefe de raid
#   RAID_META_DAMAGE_PCT = 3.5% — Daño porcentual al completar la meta diaria
#                                  (sobre HP máximo del jefe, una vez por jugador/día)
#   Cap acumulado de daño PASIVO (metas diarias, no combate):
#     Tiers R1–R4: máx 50% del HP del jefe con metas pasivas
#     Tier R5:     máx 25%
#     MAX-Solo/MAX-Party: máx 15%
#   El combate real (BattleModal) puede hacer el 100% del daño restante.
#
# Energía diaria:
#   MAX_TOWER_ENERGY = 8       — Intentos de grind en la Torre por día
#   MAX_ARENA_1V1_ENERGY = 2   — Duelos individuales en la Arena por día
#   MAX_ARENA_TOURNAMENT_ENERGY = 1 — Torneos por día
#   La energía se reinicia automáticamente cada día (detectado por todayKey).
#
# Agilidad (orden de turnos ATB-lite):
#   BOSS_SPEED_CAP_MULT = 1.4  — Un jefe nunca actúa más de 1.4x veces
#                                  que el aliado más lento de la party.
#   Valores base por clase (src/lib/balance.ts → CLASS_BALANCE):
#     cazador: 60, guerrero: 45, sabio: 40, guardia: 35
