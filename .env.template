# ============================================================
# SystemIRL — variables de entorno
# Copia este archivo a `.env` y completa tus valores reales.
# NUNCA subas `.env` al repo (ya está en .gitignore).
# ============================================================

# ---- Portal (dashboard: https://hack.useportal.co) ----------
# Publishable key (pk_...): vive en el navegador, es segura exponerla.
# Se crea en el dashboard de Portal (API Keys -> publishable).
VITE_PORTAL_PUBLISHABLE_KEY=pk_tu_publishable_key_aqui

# Secret key (sk_...): SOLO server-side. La usa el CLI para desplegar
# portal.config.ts y los serverless functions para mintear tokens.
# Se crea en el dashboard de Portal (API Keys -> secret).
# Se configura en Vercel como env var (NO como VITE_).
PORTAL_SECRET=sk_tu_secret_key_aqui

# ---- Google Gemini (https://aistudio.google.com/apikey) -------
# Key de la API de Gemini. SOLO server-side (la lee api/quests.ts).
# Se configura en Vercel como env var (NO como VITE_).
GEMINI_API_KEY=tu_gemini_api_key_aqui
