# ============================================================
# SystemIRL — variables de entorno
# Copia este archivo a `.env` y completa tus valores reales.
# NUNCA subas `.env` al repo (ya está en .gitignore).
# ============================================================

# ---- Portal (dashboard: https://hack.useportal.co) ----------
# Publishable key (pk_...): vive en el navegador, es segura exponerla.
# Se crea en el dashboard de Portal (API Keys -> publishable).
VITE_PORTAL_PUBLISHABLE_KEY=pk_tu_publishable_key_aqui

# Secret key (sk_...): SOLO server-side. La usa el CLI para desplegar
# portal.config.ts y los serverless functions para mintear tokens.
# Se crea en el dashboard de Portal (API Keys -> secret).
# Se configura en Vercel como env var (NO como VITE_).
PORTAL_SECRET=sk_tu_secret_key_aqui

# ---- Proveedor de IA para quests (api/quests.ts) -------------
# auto (default): prueba en orden los proveedores que tengan key
# configurada: gemini -> kilo -> zen.
# Puedes forzar uno: gemini | kilo | zen.
QUEST_PROVIDER=auto

# ---- Google Gemini (https://aistudio.google.com/apikey) -------
# Key de la API de Gemini. SOLO server-side (la lee api/quests.ts).
# Se configura en Vercel como env var (NO como VITE_).
# Modelos free actuales: gemini-3.6-flash (default), gemini-2.5-flash.
# Nota: gemini-2.0-flash ya NO tiene free tier (HTTP 429 limit 0).
GEMINI_API_KEY=tu_gemini_api_key_aqui
# GEMINI_MODEL=gemini-3.6-flash

# ---- Kilo Gateway (https://kilo.ai) ---------------------------
# OpenAI-compatible. Free tier ~200 req/hr, sin tarjeta de crédito.
# Modelos free: inclusionai/ling-3.0-flash:free (default),
# nvidia/nemotron-3-super-120b-a12b:free.
# Se configura en Vercel como env var (NO como VITE_).
KILO_API_KEY=tu_kilo_api_key_aqui
# KILO_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---- OpenCode Zen (https://opencode.ai/zen) -------------------
# OpenAI-compatible. Modelos free: big-pickle (default),
# deepseek-v4-flash-free, mimo-v2.5-free, nemotron-3-ultra-free.
# Key en opencode.ai -> Settings -> Zen API keys.
# Se configura en Vercel como env var (NO como VITE_).
ZEN_API_KEY=tu_zen_api_key_aqui
# ZEN_MODEL=big-pickle
